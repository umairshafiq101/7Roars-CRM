# ===========================================
# 7Roars Agency OS — Production Environment
# ===========================================
# Copy this to .env.production and fill in real values
# Used by: docker-compose.prod.yml

# Database (PostgreSQL in Docker — internal network)
DATABASE_URL="postgresql://postgres:postgres@db:5432/agency_os"
DB_USER=postgres
DB_PASSWORD=postgres

# Better Auth
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE-ME-generate-a-strong-random-secret"
BETTER_AUTH_URL="https://os.7roars.com"

# Cloudflare R2 (OPTIONAL — leave empty to use local disk storage)
# Screenshots will be stored on VPS disk at /uploads/ if R2 is not configured
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""

# App URL (must match your domain)
NEXT_PUBLIC_APP_URL="https://os.7roars.com"

# Node environment
NODE_ENV="production"
